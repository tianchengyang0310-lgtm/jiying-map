{
  "name": "photo-diary",
  "version": "1.0.0",
  "description": "照片日记 - 离线照片管理与地图浏览",
  "private": true,
  "scripts": {
    "cap:init": "npx cap init '照片日记' com.photodiary.app --web-dir www",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "cap:build": "npx cap sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "@capacitor/camera": "^6.2.0",
    "@capacitor/filesystem": "^6.2.0",
    "@capacitor/status-bar": "^6.2.0",
    "@capacitor/splash-screen": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@capacitor/android": "^6.2.0"
  }
}
